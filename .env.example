# Supabase (optional: leave these two EMPTY to run on mock data + localStorage; fill both to use Supabase)
# URL format: https://<project-ref>.supabase.co  (no trailing path like /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI gig-writing assistant (optional: without a key the built-in rule-based fallback is used)
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Rate limiting for /api/gig-assist (optional). Without these, limits are kept in memory per server
# instance. Set both to share limits across instances/deploys via Upstash Redis (REST, no SDK).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" only when running behind a proxy you control that appends x-forwarded-for.
TRUST_PROXY=
